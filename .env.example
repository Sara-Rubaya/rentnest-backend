PORT=5000
NODE_ENV=development

# PostgreSQL connection string (Neon / Supabase / Render Postgres etc.)
DATABASE_URL="postgresql://user:password@host:5432/rentnest?schema=public"

# JWT
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Stripe
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxx"

# Admin seed credentials
ADMIN_EMAIL="admin@rentnest.com"
ADMIN_PASSWORD="admin123"

# Frontend / client URL (used for Stripe redirect URLs)
CLIENT_URL="http://localhost:3000"
